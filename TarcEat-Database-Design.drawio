<mxCell id="v2" value="Accounts and access · PostgreSQL logical types · All columns required unless marked NULL" style="html=1;whiteSpace=wrap;overflow=hidden;text;align=left;verticalAlign=middle;fontSize=16;fontColor=#142e2a;" vertex="1" parent="1"><mxGeometry x="40" y="98" width="1200" height="46" as="geometry"/></mxCell>
<mxCell id="v3" value="&lt;table width=&quot;1188&quot; style=&quot;border-collapse:collapse;font-size:15px;table-layout:fixed;overflow-wrap:anywhere&quot;&gt;&lt;colgroup&gt;&lt;col width=&quot;245&quot;/&gt;&lt;col width=&quot;127&quot;/&gt;&lt;col width=&quot;290&quot;/&gt;&lt;col width=&quot;526&quot;/&gt;&lt;/colgroup&gt;&lt;tr&gt;&lt;th width=&quot;245&quot; style=&quot;padding:8px;text-align:left;background:#d7e9e1&quot;&gt;Attribute&lt;/th&gt;&lt;th width=&quot;127&quot; style=&quot;padding:8px;text-align:left;background:#d7e9e1&quot;&gt;Type&lt;/th&gt;&lt;th width=&quot;290&quot; style=&quot;padding:8px;text-align:left;background:#d7e9e1&quot;&gt;Key / nullability / default&lt;/th&gt;&lt;th width=&quot;526&quot; style=&quot;padding:8px;text-align:left;background:#d7e9e1&quot;&gt;Meaning and validation&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td width=&quot;245&quot; style=&quot;padding:6px;vertical-align:top;background:#ffffff&quot;&gt;id&lt;/td&gt;&lt;td width=&quot;127&quot; style=&quot;padding:6px;vertical-align:top;background:#ffffff&quot;&gt;uuid&lt;/td&gt;&lt;td width=&quot;290&quot; style=&quot;padding:6px;vertical-align:top;background:#ffffff&quot;&gt;PK&lt;/td&gt;&lt;td width=&quot;526&quot; style=&quot;padding:6px;vertical-align:top;background:#ffffff&quot;&gt;Application ID&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td width=&quot;245&quot; style=&quot;padding:6px;vertical-align:top;background:#f0f6f3&quot;&gt;applicant_owner_id&lt;/td&gt;&lt;td width=&quot;127&quot; style=&quot;padding:6px;vertical-align:top;background:#f0f6f3&quot;&gt;uuid&lt;/td&gt;&lt;td width=&quot;290&quot; style=&quot;padding:6px;vertical-align:top;background:#f0f6f3&quot;&gt;FK profiles.id&lt;/td&gt;&lt;td width=&quot;526&quot; style=&quot;padding:6px;vertical-align:top;background:#f0f6f3&quot;&gt;Owner who submitted the application&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td width=&quot;245&quot; style=&quot;padding:6px;vertical-align:top;background:#ffffff&quot;&gt;restaurant_name&lt;/td&g