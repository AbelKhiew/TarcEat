ckground:#ffffff&quot;&gt;voucher_redemptions.customer_voucher_id&lt;/td&gt;&lt;td width=&quot;419&quot; style=&quot;padding:6px;vertical-align:top;background:#ffffff&quot;&gt;customer_vouchers.id&lt;/td&gt;&lt;td width=&quot;170&quot; style=&quot;padding:6px;vertical-align:top;background:#ffffff&quot;&gt;0..1&lt;/td&gt;&lt;td width=&quot;190&quot; style=&quot;padding:6px;vertical-align:top;background:#ffffff&quot;&gt;0..*&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td width=&quot;410&quot; style=&quot;padding:6px;vertical-align:top;background:#f0f6f3&quot;&gt;loyalty_accounts.customer_id&lt;/td&gt;&lt;td width=&quot;419&quot; style=&quot;padding:6px;vertical-align:top;background:#f0f6f3&quot;&gt;profiles.id&lt;/td&gt;&lt;td width=&quot;170&quot; style=&quot;padding:6px;vertical-align:top;background:#f0f6f3&quot;&gt;1&lt;/td&gt;&lt;td width=&quot;190&quot; style=&quot;padding:6px;vertical-align:top;background:#f0f6f3&quot;&gt;0..1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td width=&quot;410&quot; style=&quot;padding:6px;vertical-align:top;background:#ffffff&quot;&gt;loyalty_transactions.customer_id&lt;/td&gt;&lt;td width=&quot;419&quot; style=&quot;padding:6px;vertical-align:top;background:#ffffff&quot;&gt;loyalty_accounts.customer_id&lt;/td&gt;&lt;td width=&quot;170&quot; style=&quot;padding:6px;vertical-align:top;background:#ffffff&quot;&gt;1&lt;/td&gt;&lt;td width=&quot;190&quot; style=&quot;padding:6px;vertical-align:top;background:#ffffff&quot;&gt;0..*&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td width=&quot;410&quot; style=&quot;padding:6px;vertical-align:top;background:#f0f6f3&quot;&gt;loyalty_transactions.order_id&lt;/td&gt;&lt;td width=&quot;419&quot; style=&quot;padding:6px;vertical-align:top;background:#f0f6f3&quot;&gt;orders.id&lt;/td&gt;&lt;td width=&quot;170&quot; style=&quot;padding:6px;vertical-align:top;background:#f0f6f3&quot;&gt;0..1&lt;/td&gt;&lt;td width=&quot;190&quot; style=&quot;padding:6px;vertical-align:top;background:#f0f6f3&quot;&gt;0..*&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td width=&quot;410&quot; style=&quot;padding:6px;vertical-align:top;background:#ffffff&quot;&gt;loyalty_transactions.customer_voucher_id&lt;/td&gt;&lt;td width=&quot;419&quot; style=&quot;padding:6px;vertical-align:top;background:#ffffff&quot;&gt;customer_vouchers.id&lt;/td&gt;&lt;td width=&quot;170&quot; style=&quot;padding:6px;vertical-align:top;background:#ffffff&quot;&gt;0..1&lt;/td&gt;&lt;td width=&quot;190&quot; style=&quot;padding:6px;vertical-align:top;background:#ffffff&quot;&gt;0..*&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;text;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="493" width="1189" height="442" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="page7" name="3b · Normalisation rules"><mxGraphModel grid="1" page="1" pageScale="1" pageWidth="1280" pageHeight="960"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b&gt;3b · Third normal form&lt;/b&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;fillColor=#173d35;strokeColor=none;align=left;spacingLeft=20;fontSize=29;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="36" y="26" width="1208" height="62" as="geometry"/></mxCell>
<mxCell id="v2" value="Key notation and functional dependencies for the TarcEat relational model" style="html=1;whiteSpace=wrap;overflow=hidden;text;align=left;verticalAlign=middle;fontSize=16;fontColor=#142e2a;" vertex="1" parent="1"><mxGeometry x="40" y="98" width="1200" height="46" as="geometry"/></mxCell>
<mxCell id="v3" value="&lt;b&gt;First normal form&lt;/b&gt;&lt;br&gt;Each attribute holds one value. Repeating cart lines and receipt order IDs become separate relations." style="html=1;whiteSpace=wrap;overflow=hidden;text;align=left;verticalAlign=middle;fontSize=17;fontColor=#142e2a;" vertex="1" parent="1"><mxGeometry x="40" y="155" width="1190" height="91" as="geometry"/></mxCell>
<mxCell id="v4" value="&lt;b&gt;Second normal form&lt;/b&gt;&lt;br&gt;Cart line fields depend on the whole (cart_id, line_id) key. Receipt membership has only the (receipt_id, order_id) key." style="html=1;whiteSpace=wrap;overflow=hidden;text;align=left;verticalAlign=middle;fontSize=17;fontColor=#142e2a;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="1190" height="91" as="geometry"/></mxCell>
<mxCell id="v5" value="&lt;b&gt;Third normal form&lt;/b&gt;&lt;br&gt;Current menu, account and voucher details are stored with their own keys. Store historical order-line names and prices as facts captured at checkout." style="html=1;whiteSpace=wrap;overflow=hidden;text;align=left;verticalAlign=middle;fontSize=17;fontColor=#142e2a;" vertex="1" parent="1"><mxGeometry x="40" y="365" width="1190" height="91" as="geometry"/></mxCell>
<mxCell id="v6" value="&lt;b&gt;Derived values&lt;/b&gt;&lt;br&gt;Line total = quantity × unit_price_sen. Order total = line totals − discount + tax + delivery. Receipt totals come from its immutable order membership and order amounts." style="html=1;whiteSpace=wrap;overflow=hidden;text;align=left;verticalAlign=middle;fontSize=17;fontColor=#142e2a;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="1190" height="91" as="geometry"/></mxCell>
<mxCell id="v7" value="&lt;b&gt;Derived status and balances&lt;/b&gt;&lt;br&gt;Visit occupancy uses closed_at. Points use the sum of signed ledger entries. Voucher usage counts unreversed redemptions. Payment records supply payment status." style="html=1;whiteSpace=wrap;overflow=hidden;text;align=left;verticalAlign=middle;fontSize=17;fontColor=#142e2a;" vertex="1" parent="1"><mxGeometry x="40" y="575" width="1190" height="91" as="geometry"/></mxCell>
<mxCell id="v8" value="&lt;b&gt;Code and database mapping&lt;/b&gt;&lt;br&gt;JSON development IDs map to UUIDs. Supabase Auth owns credentials. Restaurant location is derived from an item's category and a visit's table. Order voucher references come from redemption." style="html=1;whiteSpace=wrap;overflow=hidden;text;align=left;verticalAlign=middle;fontSize=17;fontColor=#142e2a;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="1190" height="91" as="geometry"/></mxCell>
<mxCell id="v9" value="&lt;b&gt;Workflow rules&lt;/b&gt;&lt;br&gt;Award one point per whole RM1 after merchandise discount and exclude tax and delivery. Award once per completed registered order. Finalisation, claiming, redemption and reversal use database transactions." style="html=1;whiteSpace=wrap;overflow=hidden;text;align=left;verticalAlign=middle;fontSize=17;fontColor=#142e2a;" vertex="1" parent="1"><mxGeometry x="40" y="785" width="1190" height="91" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="page8" name="3b · Accounts and access"><mxGraphModel grid="1" page="1" pageScale="1" pageWidth="1280" pageHeight="960"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b&gt;3b · 3NF relations | Accounts and access&lt;/b&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;fillColor=#173d35;strokeColor=none;align=left;spacingLeft=20;fontSize=29;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="36" y="26" width="1208" height="62" as="geometry"/></mxCell>
<mxCell id="v2" value="PK = primary key · FK = foreign key · UQ = alternate unique key · NULL = optional" style="html=1;whiteSpace=wrap;overflow=hidden;text;align=left;verticalAlign=middle;fontSize=16;fontColor=#142e2a;" vertex="1" parent="1"><mxGeometry x="40" y="98" width="1200" height="46" as="geometry"/></mxCell>
<mxCell id="v3" value="&lt;b&gt;profiles&lt;/b&gt;&lt;br&gt;id [PK FK auth.users.id], full_name, email [UQ], phone, address, role, is_active, created_at&lt;br&gt;&lt;br&gt;&lt;b&gt;Dependency&lt;/b&gt; (id) → all non-key attributes." style="html=1;whiteSpace=wrap;overflow=hidden;rounded=1;fillColor=#edf6f1;strokeColor=#83a99b;align=left;verticalAlign=top;spacing=11;fontSize=16;fontColor=#142e2a;" vertex="1" parent="1"><mxGeometry x="40" y="149" width="1192" height="132" as="geometry"/></mxCell>
<mxCell id="v4" value="&lt;b&gt;restaurant_applications&lt;/b&gt;&lt;br&gt;id [PK], applicant_owner_id [FK profiles.id], restaurant_name, address, contact_phone, bio, status, review_reason, reviewed_by [FK profiles.id NULL], created_at, reviewed_at&lt;br&gt;&lt;br&gt;&lt;b&gt;Dependency&lt;/b&gt; (id) → all non-key attributes.&lt;br&gt;&lt;b&gt;Constraints&lt;/b&gt; Reviewer must have root_admin role. Review time required for finalized applications." style="html=1;whiteSpace=wrap;overflow=hidden;rounded=1;fillColor=#edf6f1;strokeColor=#83a99b;align=left;verticalAlign=top;spacing=11;fontSize=16;fontColor=#142e2a;" vertex="1" parent="1"><mxGeometry x="40" y="293" width="1192" height="152" as="geometry"/></mxCell>
<mxCell id="v5" value="&lt;b&gt;restaurants&lt;/b&gt;&lt;br&gt;id [PK], owner_id [FK profiles.id], application_id [FK restaurant_applications.id UQ NULL], name, address, phone, bio, status, is_open, tax_rate_bps, delivery_fee_sen, created_at&lt;br&gt;&lt;br&gt;&lt;b&gt;Dependency&lt;/b&gt; (id) → all non-key attributes.&lt;br&gt;&lt;b&gt;Constraints&lt;/b&gt; Owner role required. If an application exists, it must be approved for the same owner." style="html=1;whiteSpace=wrap;overflow=hidden;rounded=1;fillColor=#edf6f1;strokeColor=#83a99b;align=left;verticalAlign=top;spacing=11;fontSize=16;fontColor=#142e2a;" vertex="1" parent="1"><mxGeometry x="40" y="457" width="1192" height="152" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="page9" name="3b · Menu and tables 1"><mxGraphModel grid="1" page="1" pageScale="1" pageWidth="1280" pageHeight="960"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b&gt;3b · 3NF relations | Menu and tables&lt;/b&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;fillColor=#173d35;strokeColor=none;align=left;spacingLeft=20;fontSize=29;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="36" y="26" width="1208" height="62" as="geometry"/></mxCell>
<mxCell id="v2" value="PK = primary key · FK = foreign key · UQ = alternate unique key · NULL = optional" style="html=1;whiteSpace=wrap;overflow=hidden;text;align=left;verticalAlign=middle;fontSize=16;fontColor=#142e2a;" vertex="1" parent="1"><mxGeometry x="40" y="98" width="1200" height="46" as="geometry"/></mxCell>
<mxCell id="v3" value="&lt;b&gt;categories&lt;/b&gt;&lt;br&gt;id [PK], restaurant_id [FK restaurants.id], name&lt;br&gt;&lt;br&gt;&lt;b&gt;Dependency&lt;/b&gt; (id) → all non-key attributes.&lt;br&gt;&lt;b&gt;Constraints&lt;/b&gt; UQ (restaurant_id, lower(name))" style="html=1;whiteSpace=wrap;overflow=hidden;rounded=1;fillColor=#edf6f1;strokeColor=#83a99b;align=left;verticalAlign=top;spacing=11;fontSize=16;fontColor=#142e2a;" vertex="1" parent="1"><mxGeometry x="40" y="149" width="1192" height="132" as="geometry"/></mxCell>
<mxCell id="v4" value="&lt;b&gt;menu_items&lt;/b&gt;&lt;br&gt;id [PK], category_id [FK categories.id], name, description, price_sen, image_url, is_available, archived_at&lt;br&gt;&lt;br&gt;&lt;b&gt;Dependency&lt;/b&gt; (id) → all non-key attributes.&lt;br&gt;&lt;b&gt;Constraints&lt;/b&gt; Positive price. Archive disables availability. Keep referenced item history." style="html=1;whiteSpace=wrap;overflow=hidden;rounded=1;fillColor=#edf6f1;strokeColor=#83a99b;align=left;verticalAlign=top;spacing=11;fontSize=16;fontColor=#142e2a;" vertex="1" parent="1"><mxGeometry x="40" y="293" width="1192" height="132" as="geometry"/></mxCell>
<mxCell id="v5" value="&lt;b&gt;restaurant_tables&lt;/b&gt;&lt;br&gt;id [PK], restaurant_id [FK restaurants.id], table_number, qr_token [UQ]&lt;br&gt;&lt;br&gt;&lt;b&gt;Dependency&lt;/b&gt; (id) → all non-key attributes.&lt;br&gt;&lt;b&gt;Constraints&lt;/b&gt; UQ (restaurant_id, table_number)" style="html=1;whiteSpace=wrap;overflow=hidden;rounded=1;fillColor=#edf6f1;strokeColor=#83a99b;align=left;verticalAlign=top;spacing=11;fontSize=16;fontColor=#142e2a;" vertex="1" parent="1"><mxGeometry x="40" y="437" width="1192" height="132" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="page10" name="3b · Menu and tables 2"><mxGraphModel grid="1" page="1" pageScale="1" pageWidth="1280" pageHeight="960"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b&gt;3b · 3NF relations | Menu and tables&lt;/b&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;fillColor=#173d35;strokeColor=none;align=left;spacingLeft=20;fontSize=29;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="36" y="26" width="1208" height="62" as="geometry"/></mxCell>
<mxCell id="v2" value="PK = primary key · FK = foreign key · UQ = alternate unique key · NULL = optional" style="html=1;whiteSpace=wrap;overflow=hidden;text;align=left;verticalAlign=middle;fontSize=16;fontColor=#142e2a;" vertex="1" parent="1"><mxGeometry x="40" y="98" width="1200" height="46" as="geometry"/></mxCell>
<mxCell id="v3" value="&lt;b&gt;table_visits&lt;/b&gt;&lt;br&gt;id [PK], table_id [FK restaurant_tables.id], opened_at, closed_at&lt;br&gt;&lt;br&gt;&lt;b&gt;Dependency&lt;/b&gt; (id) → all non-key attributes.&lt;br&gt;&lt;b&gt;Constraints&lt;/b&gt; Partial UQ (table_id) WHERE closed_at IS NULL. closed_at ≥ opened_at." style="html=1;whiteSpace=wrap;overflow=hidden;rounded=1;fillColor=#edf6f1;strokeColor=#83a99b;align=left;verticalAlign=top;spacing=11;fontSize=16;fontColor=#142e2a;" vertex="1" parent="1"><mxGeometry x="40" y="149" width="1192" height="132" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="page11" name="3b · Cart and orders 1"><mxGraphModel grid="1" page="1" pageScale="1" pageWidth="1280" pageHeight="960"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b&gt;3b · 3NF relations | Cart and orders&lt;/b&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;fillColor=#173d35;strokeColor=none;align=left;spacingLeft=20;fontSize=29;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="36" y="26" width="1208" height="62" as="geometry"/></mxCell>
<mxCell id="v2" value="PK = primary key · FK = foreign key · UQ = alternate unique key · NULL = optional" style="html=1;whiteSpace=wrap;overflow=hidden;text;align=left;verticalAlign=middle;fontSize=16;fontColor=#142e2a;" vertex="1" parent="1"><mxGeometry x="40" y="98" width="1200" height="46" as="geometry"/></mxCell>
<mxCell id="v3" value="&lt;b&gt;carts&lt;/b&gt;&lt;br&gt;id [PK], customer_id [FK profiles.id NULL], guest_token_digest, restaurant_id [FK restaurants.id], table_id [FK restaurant_tables.id NULL], mode, updated_at&lt;br&gt;&lt;br&gt;&lt;b&gt;Dependency&lt;/b&gt; (id) → all non-key attributes.&lt;br&gt;&lt;b&gt;Constraints&lt;/b&gt; Exactly one of customer_id / guest_token_digest. For dine-in require table_id and verify it belongs to the restaurant." style="html=1;whiteSpace=wrap;overflow=hidden;rounded=1;fillColor=#edf6f1;strokeColor=#83a99b;align=left;verticalAlign=top;spacing=11;fontSize=16;fontColor=#142e2a;" vertex="1" parent="1"><mxGeometry x="40" y="149" width="1192" height="152" as="geometry"/></mxCell>
<mxCell id="v4" value="&lt;b&gt;cart_lines&lt;/b&gt;&lt;br&gt;cart_id [PK FK carts.id], line_id [PK], item_id [FK menu_items.id], quantity, note&lt;br&gt;&lt;br&gt;&lt;b&gt;Dependency&lt;/b&gt; (cart_id, line_id) → all non-key attributes." style="html=1;whiteSpace=wrap;overflow=hidden;rounded=1;fillColor=#edf6f1;strokeColor=#83a99b;align=left;verticalAlign=top;spacing=11;fontSize=16;fontColor=#142e2a;" vertex="1" parent="1"><mxGeometry x="40" y="313" width="1192" height="132" as="geometry"/></mxCell>
<mxCell id="v5" value="&lt;b&gt;orders&lt;/b&gt;&lt;br&gt;id [PK], restaurant_id [FK restaurants.id NULL], customer_id [FK profiles.id NULL], visit_id [FK table_visits.id NULL], checkout_request_id [UQ], guest_tracking_digest, mode, contact_name, contact_phone, delivery_address, pickup_time, discount_sen, tax_sen, delivery_fee_sen, payment_method, status, cancellation_status, cancellation_reason, created_at, completed_at, archived_at&lt;br&gt;&lt;br&gt;&lt;b&gt;Dependency&lt;/b&gt; (id) → all non-key attributes.&lt;br&gt;&lt;b&gt;Constraints&lt;/b&gt; Dine-in uses visit_id only. Pickup/delivery uses restaurant_id only. Guest orders require a tracking digest. Delivery address and pickup time follow mode." style="html=1;whiteSpace=wrap;overflow=hidden;rounded=1;fillColor=#edf6f1;strokeColor=#83a99b;align=left;verticalAlign=top;spacing=11;fontSize=16;fontColor=#142e2a;" vertex="1" parent="1"><mxGeometry x="40" y="457" width="1192" height="212" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="page12" name="3b · Cart and orders 2"><mxGraphModel grid="1" page="1" pageScale="1" pageWidth="1280" pageHeight="960"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b&gt;3b · 3NF relations | Cart and orders&lt;/b&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;fillColor=#173d35;strokeColor=none;align=left;spacingLeft=20;fontSize=29;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="36" y="26" width="1208" height="62" as="geometry"/></mxCell>
<mxCell id="v2" value="PK = primary key · FK = foreign key · UQ = alternate unique key · NULL = optional" style="html=1;whiteSpace=wrap;overflow=hidden;text;align=left;verticalAlign=middle;fontSize=16;fontColor=#142e2a;" vertex="1" parent="1"><mxGeometry x="40" y="98" width="1200" height="46" as="geometry"/></mxCell>
<mxCell id="v3" value="&lt;b&gt;order_items&lt;/b&gt;&lt;br&gt;id [PK], order_id [FK orders.id], item_id [FK menu_items.id], item_name, quantity, unit_price_sen, note&lt;br&gt;&lt;br&gt;&lt;b&gt;Dependency&lt;/b&gt; (id) → all non-key attributes.&lt;br&gt;&lt;b&gt;Constraints&lt;/b&gt; Freeze name and price at checkout. Verify item belongs to the order's restaurant." style="html=1;whiteSpace=wrap;overflow=hidden;rounded=1;fillColor=#edf6f1;strokeColor=#83a99b;align=left;verticalAlign=top;spacing=11;fontSize=16;fontColor=#142e2a;" vertex="1" parent="1"><mxGeometry x="40" y="149" width="1192" height="132" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="page13" name="3b · Payments and receipts"><mxGraphModel grid="1" page="1" pageScale="1" pageWidth="1280" pageHeight="960"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b&gt;3b · 3NF relations | Payments and receipts&lt;/b&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;fillColor=#173d35;strokeColor=none;align=left;spacingLeft=20;fontSize=29;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="36" y="26" width="1208" height="62" as="geometry"/></mxCell>
<mxCell id="v2" value="PK = primary key · FK = foreign key · UQ = alternate unique key · NULL = optional" style="html=1;whiteSpace=wrap;overflow=hidden;text;align=left;verticalAlign=middle;fontSize=16;fontColor=#142e2a;" vertex="1" parent="1"><mxGeometry x="40" y="98" width="1200" height="46" as="geometry"/></mxCell>
<mxCell id="v3" value="&lt;b&gt;payment_records&lt;/b&gt;&lt;br&gt;id [PK], order_id [FK orders.id UQ NULL], visit_id [FK table_visits.id UQ NULL], method, status, is_simulated, amount_sen, paid_at, refunded_at&lt;br&gt;&lt;br&gt;&lt;b&gt;Dependency&lt;/b&gt; (id) → all non-key attributes.&lt;br&gt;&lt;b&gt;Constraints&lt;/b&gt; Exactly one of order_id / visit_id. Each is individually unique when present. Refund time requires refunded status." style="html=1;whiteSpace=wrap;overflow=hidden;rounded=1;fillColor=#edf6f1;strokeColor=#83a99b;align=left;verticalAlign=top;spacing=11;fontSize=16;fontColor=#142e2a;" vertex="1" parent="1"><mxGeometry x="40" y="149" width="1192" height="152" as="geometry"/></mxCell>
<mxCell id="v4" value="&lt;b&gt;receipts&lt;/b&gt;&lt;br&gt;id [PK], receipt_number [UQ], payment_id [FK payment_records.id UQ], issued_at&lt;br&gt;&lt;br&gt;&lt;b&gt;Dependency&lt;/b&gt; (id) → all non-key attributes.&lt;br&gt;&lt;b&gt;Constraints&lt;/b&gt; One receipt per payment. Issue only for settled payments. Repeat completion returns the existing receipt." style="html=1;whiteSpace=wrap;overflow=hidden;rounded=1;fillColor=#edf6f1;strokeColor=#83a99b;align=left;verticalAlign=top;spacing=11;fontSize=16;fontColor=#142e2a;" vertex="1" parent="1"><mxGeometry x="40" y="313" width="1192" height="132" as="geometry"/></mxCell>
<mxCell id="v5" value="&lt;b&gt;receipt_orders&lt;/b&gt;&lt;br&gt;receipt_id [PK FK receipts.id], order_id [PK FK orders.id]&lt;br&gt;&lt;br&gt;&lt;b&gt;Dependency&lt;/b&gt; (receipt_id, order_id) → key-only relation.&lt;br&gt;&lt;b&gt;Constraints&lt;/b&gt; Membership must match the settled order or the paid visit. Receipt includes at least one order." style="html=1;whiteSpace=wrap;overflow=hidden;rounded=1;fillColor=#edf6f1;strokeColor=#83a99b;align=left;verticalAlign=top;spacing=11;fontSize=16;fontColor=#142e2a;" vertex="1" parent="1"><mxGeometry x="40" y="457" width="1192" height="132" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="page14" name="3b · Vouchers and points 1"><mxGraphModel grid="1" page="1" pageScale="1" pageWidth="1280" pageHeight="960"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b&gt;3b · 3NF relations | Vouchers and points&lt;/b&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;fillColor=#173d35;strokeColor=none;align=left;spacingLeft=20;fontSize=29;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="36" y="26" width="1208" height="62" as="geometry"/></mxCell>
<mxCell id="v2" value="PK = primary key · FK = foreign key · UQ = alternate unique key · NULL = optional" style="html=1;whiteSpace=wrap;overflow=hidden;text;align=left;verticalAlign=middle;fontSize=16;fontColor=#142e2a;" vertex="1" parent="1"><mxGeometry x="40" y="98" width="1200" height="46" as="geometry"/></mxCell>
<mxCell id="v3" value="&lt;b&gt;vouchers&lt;/b&gt;&lt;br&gt;id [PK], restaurant_id [FK restaurants.id NULL], created_by [FK profiles.id], code, discount_sen, minimum_spend_sen, points_cost, expires_at, claim_enabled, is_usable, total_use_limit, per_customer_use_limit, uses_per_claim, archived_at&lt;br&gt;&lt;br&gt;&lt;b&gt;Dependency&lt;/b&gt; (id) → all non-key attributes.&lt;br&gt;&lt;b&gt;Constraints&lt;/b&gt; Unique code per scope: UQ (restaurant_id, code) for local and UQ (code) WHERE restaurant_id IS NULL for platform." style="html=1;whiteSpace=wrap;overflow=hidden;rounded=1;fillColor=#edf6f1;strokeColor=#83a99b;align=left;verticalAlign=top;spacing=11;fontSize=16;fontColor=#142e2a;" vertex="1" parent="1"><mxGeometry x="40" y="149" width="1192" height="152" as="geometry"/></mxCell>
<mxCell id="v4" value="&lt;b&gt;customer_vouchers&lt;/b&gt;&lt;br&gt;id [PK], customer_id [FK profiles.id], voucher_id [FK vouchers.id], claimed_at, use_limit, is_disabled&lt;br&gt;&lt;br&gt;&lt;b&gt;Dependency&lt;/b&gt; (id) → all non-key attributes.&lt;br&gt;&lt;b&gt;Constraints&lt;/b&gt; Customer role required. Existing platform claims retain their original allowance and survive offer withdrawal." style="html=1;whiteSpace=wrap;overflow=hidden;rounded=1;fillColor=#edf6f1;strokeColor=#83a99b;align=left;verticalAlign=top;spacing=11;fontSize=16;fontColor=#142e2a;" vertex="1" parent="1"><mxGeometry x="40" y="313" width="1192" height="132" as="geometry"/></mxCell>
<mxCell id="v5" value="&lt;b&gt;voucher_redemptions&lt;/b&gt;&lt;br&gt;order_id [PK FK orders.id], voucher_id [FK vouchers.id NULL], customer_voucher_id [FK customer_vouchers.id NULL], redeemed_at, reversed_at&lt;br&gt;&lt;br&gt;&lt;b&gt;Dependency&lt;/b&gt; (order_id) → all non-key attributes.&lt;br&gt;&lt;b&gt;Constraints&lt;/b&gt; Exactly one of voucher_id / customer_voucher_id. Order must be registered; validate restaurant, claim ownership, expiry and limits." style="html=1;whiteSpace=wrap;overflow=hidden;rounded=1;fillColor=#edf6f1;strokeColor=#83a99b;align=left;verticalAlign=top;spacing=11;fontSize=16;fontColor=#142e2a;" vertex="1" parent="1"><mxGeometry x="40" y="457" width="1192" height="172" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="page15" name="3b · Vouchers and points 2"><mxGraphModel grid="1" page="1" pageScale="1" pageWidth="1280" pageHeight="960"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b&gt;3b · 3NF relations | Vouchers and points&lt;/b&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;fillColor=#173d35;strokeColor=none;align=left;spacingLeft=20;fontSize=29;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="36" y="26" width="1208" height="62" as="geometry"/></mxCell>
<mxCell id="v2" value="PK = primary key · FK = foreign key · UQ = alternate unique key · NULL = optional" style="html=1;whiteSpace=wrap;overflow=hidden;text;align=left;verticalAlign=middle;fontSize=16;fontColor=#142e2a;" vertex="1" parent="1"><mxGeometry x="40" y="98" width="1200" height="46" as="geometry"/></mxCell>
<mxCell id="v3" value="&lt;b&gt;loyalty_accounts&lt;/b&gt;&lt;br&gt;customer_id [PK FK profiles.id]&lt;br&gt;&lt;br&gt;&lt;b&gt;Dependency&lt;/b&gt; (customer_id) → key-only relation." style="html=1;whiteSpace=wrap;overflow=hidden;rounded=1;fillColor=#edf6f1;strokeColor=#83a99b;align=left;verticalAlign=top;spacing=11;fontSize=16;fontColor=#142e2a;" vertex="1" parent="1"><mxGeometry x="40" y="149" width="1192" height="132" as="geometry"/></mxCell>
<mxCell id="v4" value="&lt;b&gt;loyalty_transactions&lt;/b&gt;&lt;br&gt;id [PK], customer_id [FK loyalty_accounts.customer_id], order_id [FK orders.id NULL], customer_voucher_id [FK customer_vouchers.id NULL], type, points_delta, created_at&lt;br&gt;&lt;br&gt;&lt;b&gt;Dependency&lt;/b&gt; (id) → all non-key attributes.&lt;br&gt;&lt;b&gt;Constraints&lt;/b&gt; Partial UQ (order_id) for order_completion and UQ (customer_voucher_id) for voucher_claim. Check reference, account ownership and points sign by type." style="html=1;whiteSpace=wrap;overflow=hidden;rounded=1;fillColor=#edf6f1;strokeColor=#83a99b;align=left;verticalAlign=top;spacing=11;fontSize=16;fontColor=#142e2a;" vertex="1" parent="1"><mxGeometry x="40" y="293" width="1192" height="172" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="page16" name="3c · profiles"><mxGraphModel grid="1" page="1" pageScale="1" pageWidth="1280" pageHeight="960"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b&gt;3c · Data dictionary | profiles&lt;/b&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;fillColor=#173d35;strokeColor=none;align=left;spacingLeft=20;fontSize=29;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="36" y="26" width="1208" height="62" as="geometry"/></mxCell>
<mxCell id="v2" value="Accounts and access · PostgreSQL logical types · All columns required unless marked NULL" style="html=1;whiteSpace=wrap;overflow=hidden;text;align=left;verticalAlign=middle;fontSize=16;fontColor=#142e2a;" vertex="1" parent="1"><mxGeometry x="40" y="98" width="1200" height="46" as="geometry"/></mxCell>
<mxCell id="v3" value="&lt;table width=&quot;1188&quot; style=&quot;border-collapse:collapse;font-size:15px;table-layout:fixed;overflow-wrap:anywhere&quot;&gt;&lt;colgroup&gt;&lt;col width=&quot;245&quot;/&gt;&lt;col width=&quot;127&quot;/&gt;&lt;col width=&quot;290&quot;/&gt;&lt;col width=&quot;526&quot;/&gt;&lt;/colgroup&gt;&lt;tr&gt;&lt;th width=&quot;245&quot; style=&quot;padding:8px;text-align:left;background:#d7e9e1&quot;&gt;Attribute&lt;/th&gt;&lt;th width=&quot;127&quot; style=&quot;padding:8px;text-align:left;background:#d7e9e1&quot;&gt;Type&lt;/th&gt;&lt;th width=&quot;290&quot; style=&quot;padding:8px;text-align:left;background:#d7e9e1&quot;&gt;Key / nullability / default&lt;/th&gt;&lt;th width=&quot;526&quot; style=&quot;padding:8px;text-align:left;background:#d7e9e1&quot;&gt;Meaning and validation&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td width=&quot;245&quot; style=&quot;padding:6px;vertical-align:top;background:#ffffff&quot;&gt;id&lt;/td&gt;&lt;td width=&quot;127&quot; style=&quot;padding:6px;vertical-align:top;background:#ffffff&quot;&gt;uuid&lt;/td&gt;&lt;td width=&quot;290&quot; style=&quot;padding:6px;vertical-align:top;background:#ffffff&quot;&gt;PK FK auth.users.id&lt;/td&gt;&lt;td width=&quot;526&quot; style=&quot;padding:6px;vertical-align:top;background:#ffffff&quot;&gt;Authenticated user ID from Supabase Auth&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td width=&quot;245&quot; style=&quot;padding:6px;vertical-align:top;background:#f0f6f3&quot;&gt;full_name&lt;/td&gt;&lt;td width=&quot;127&quot; style=&quot;padding:6px;vertical-align:top;background:#f0f6f3&quot;&gt;varchar(120)&lt;/td&gt;&lt;td width=&quot;290&quot; style=&quot;padding:6px;vertical-align:top;background:#f0f6f3&quot;&gt;Required&lt;/td&gt;&lt;td width=&quot;526&quot; style=&quot;padding:6px;vertical-align:top;background:#f0f6f3&quot;&gt;User display name&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td width=&quot;245&quot; style=&quot;padding:6px;vertical-align:top;background:#ffffff&quot;&gt;email&lt;/td&gt;&lt;td width=&quot;127&quot; style=&quot;padding:6px;vertical-align:top;background:#ffffff&quot;&gt;varchar(254)&lt;/td&gt;&lt;td width=&quot;290&quot; style=&quot;padding:6px;vertical-align:top;background:#ffffff&quot;&gt;UQ&lt;/td&gt;&lt;td width=&quot;526&quot; style=&quot;padding:6px;vertical-align:top;background:#ffffff&quot;&gt;Normalized application email, synced with Auth&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td width=&quot;245&quot; style=&quot;padding:6px;vertical-align:top;background:#f0f6f3&quot;&gt;phone&lt;/td&gt;&lt;td width=&quot;127&quot; style=&quot;padding:6px;vertical-align:top;background:#f0f6f3&quot;&gt;varchar(20)&lt;/td&gt;&lt;td width=&quot;290&quot; style=&quot;padding:6px;vertical-align:top;background:#f0f6f3&quot;&gt;Required&lt;/td&gt;&lt;td width=&quot;526&quot; style=&quot;padding:6px;vertical-align:top;background:#f0f6f3&quot;&gt;Contact phone&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td width=&quot;245&quot; style=&quot;padding:6px;vertical-align:top;background:#ffffff&quot;&gt;address&lt;/td&gt;&lt;td width=&quot;127&quot; style=&quot;padding:6px;vertical-align:top;background:#ffffff&quot;&gt;varchar(500)&lt;/td&gt;&lt;td width=&quot;290&quot; style=&quot;padding:6px;vertical-align:top;background:#ffffff&quot;&gt;NULL&lt;/td&gt;&lt;td width=&quot;526&quot; style=&quot;padding:6px;vertical-align:top;background:#ffffff&quot;&gt;Saved customer address&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td width=&quot;245&quot; style=&quot;padding:6px;vertical-align:top;background:#f0f6f3&quot;&gt;role&lt;/td&gt;&lt;td width=&quot;127&quot; style=&quot;padding:6px;vertical-align:top;background:#f0f6f3&quot;&gt;enum&lt;/td&gt;&lt;td width=&quot;290&quot; style=&quot;padding:6px;vertical-align:top;background:#f0f6f3&quot;&gt;Required&lt;/td&gt;&lt;td width=&quot;526&quot; style=&quot;padding:6px;vertical-align:top;background:#f0f6f3&quot;&gt;root_admin, owner or customer&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td width=&quot;245&quot; style=&quot;padding:6px;vertical-align:top;background:#ffffff&quot;&gt;is_active&lt;/td&gt;&lt;td width=&quot;127&quot; style=&quot;padding:6px;vertical-align:top;background:#ffffff&quot;&gt;boolean&lt;/td&gt;&lt;td width=&quot;290&quot; style=&quot;padding:6px;vertical-align:top;background:#ffffff&quot;&gt;DEFAULT true&lt;/td&gt;&lt;td width=&quot;526&quot; style=&quot;padding:6px;vertical-align:top;background:#ffffff&quot;&gt;Whether the profile can access the application&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td width=&quot;245&quot; style=&quot;padding:6px;vertical-align:top;background:#f0f6f3&quot;&gt;created_at&lt;/td&gt;&lt;td width=&quot;127&quot; style=&quot;padding:6px;vertical-align:top;background:#f0f6f3&quot;&gt;timestamptz&lt;/td&gt;&lt;td width=&quot;290&quot; style=&quot;padding:6px;vertical-align:top;background:#f0f6f3&quot;&gt;DEFAULT now()&lt;/td&gt;&lt;td width=&quot;526&quot; style=&quot;padding:6px;vertical-align:top;background:#f0f6f3&quot;&gt;Profile creation time&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;text;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="151" width="1188" height="784" as="geometry"/></mxCell></root></mxGraphModel></diagram>
